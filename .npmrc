# The shared theme is published to GitHub Packages, which wants a token even to read.
@radiosilence:registry=https://npm.pkg.github.com

# The token lives in a file this one points at, not in an ${ENV} here: aube refuses to expand environment variables in
# auth settings a project controls, since a checked-in .npmrc could otherwise exfiltrate the environment of anyone who
# installs. `just auth` writes it from GH_TOKEN or the gh login.
npmrc-auth-file=.npmrc.auth
